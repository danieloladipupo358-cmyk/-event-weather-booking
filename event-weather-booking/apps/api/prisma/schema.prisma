generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CUSTOMER)
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  category    String
  venue       String
  city        String
  latitude    Float
  longitude   Float
  startsAt    DateTime
  price       Int
  capacity    Int
  imageUrl    String?
  isOutdoor   Boolean   @default(false)
  published   Boolean   @default(false)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([published, startsAt])
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  eventId   String
  quantity  Int
  status    BookingStatus @default(CONFIRMED)
  user      User          @relation(fields: [userId], references: [id])
  event     Event         @relation(fields: [eventId], references: [id])
  payment   Payment?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([eventId, status])
  @@index([userId, createdAt])
}

model Payment {
  id                  String        @id @default(cuid())
  bookingId           String        @unique
  provider            String
  providerReference   String?       @unique
  amount              Int
  currency            String        @default("NGN")
  status              PaymentStatus @default(PENDING)
  providerConfirmedAt DateTime?
  booking             Booking       @relation(fields: [bookingId], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}
