# PostgreSQL connection string for your local or hosted PostgreSQL database.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/setmore?schema=public"

# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

PORT=4000
CUSTOMER_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Keep lax for local and same-site deployments; set "none" only for separate cross-site hosts.
COOKIE_SAME_SITE="lax"

# Local practice mode only. PostgreSQL-backed accounts are used when false.
DEMO_AUTH="false"
DEMO_ADMIN_EMAIL=""
