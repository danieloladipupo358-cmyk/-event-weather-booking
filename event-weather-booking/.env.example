# Copy this file to apps/api/.env and replace the placeholders.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/setmore?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
CUSTOMER_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Set in apps/customer-web/.env only if the API isn't at localhost:4000.
VITE_API_URL="http://localhost:4000/api"

# Keep lax for local and same-site deployments; set "none" only for separate cross-site hosts.
COOKIE_SAME_SITE="lax"
